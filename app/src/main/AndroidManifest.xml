<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- In-app self-update (Settings → التحديثات): lets the system
         installer be launched directly from this app for the APK it just
         downloaded itself, instead of sending the person to an external
         browser/file manager. On API 26+ the person still has to flip a
         one-time "السماح من هذا المصدر" toggle for this app specifically
         (see ApkDownloader.canInstallPackages) — this permission alone
         doesn't silently install anything. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      FEATURE ADDED (package visibility, Android 11+/API 30+): declares the
      two implicit ACTION_VIEW intents this app ever fires at another app —
      installing the self-downloaded update APK (ApkDownloader.install) and
      handing off an external http/https link tapped inside the help/
      privacy in-app browser (WebViewScreen) to the system browser. Both
      targets (the package installer, the default browser) are already on
      Android's own automatic-visibility allowlist and worked without this
      even before — this makes that visibility explicit and future-proof
      instead of silently depending on an OS default that could vary by
      OEM/ROM, and is the pattern Play Console itself recommends for an
      app that installs its own updates.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android.package-archive" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".ShopManagerApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShopManager"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <!--
          FEATURE ADDED (privacy — ties directly into "سياسة الخصوصية": "لا
          يحتوي على إعلانات أو أدوات تتبع"): WebView itself can otherwise
          collect and send anonymous usage metrics for every WebView in the
          app, independent of anything the app's own code does — this is
          the documented AndroidX/AOSP switch to opt every WebView instance
          (the help/privacy pages) out of that collection app-wide.
        -->
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!--
          PERF FIX (startup jitter): androidx.work auto-registers a
          ContentProvider (WorkManagerInitializer) that runs before
          Application.onCreate on EVERY cold start, unconditionally, the
          moment the work-runtime-ktx dependency exists in the app —
          whether or not a worker is ever scheduled yet. That provider
          builds WorkManager's Room database on the spot, on the main
          thread. On a fast phone that's invisible; on a slow eMMC/2GB
          device it's real main-thread time competing with the very
          first Compose frames — exactly what shows up as the app
          "shaking" for the first couple of seconds. Removing this
          default initializer moves that same setup to run lazily
          instead (see ShopManagerApplication + MainActivity, where it
          now happens off the main thread, after the splash screen is
          already covering the UI).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!--
          Used by MaterialsReportImage to share the generated PNG report
          image (see the "مشاركة" button on the materials screen) - lets
          the share-sheet target app read the file from our cache dir
          without exposing any other app storage.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.ShopManager.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Needed to launch the system package installer on the .apk we download ourselves
         (in-app download + install, instead of sending the user to the browser). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- تحميل التحديث بالخلفية عبر UpdateDownloadService (خدمة أمامية
         حقيقية) + إظهار إشعار التقدّم بهوية التطبيق. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- تصريح صريح بدعم كل أحجام الشاشات وكل كثافات البكسل (DPI): بدونه
         Android يفترض الدعم افتراضياً لكل الأجهزة الحديثة، لكن الوسم هنا
         يجعل الأمر رسمياً وصريحاً بدل الاعتماد على سلوك افتراضي ضمني —
         وهو ما يعتمد عليه أيضاً متجر Play لفلترة توافق الجهاز. anyDensity
         يمنع النظام من إعادة تحجيم موارد كثافة واحدة لتناسب كل الأجهزة
         (وهو ما يسبب ضبابية)؛ التطبيق أصلاً يوفّر موارد mipmap منفصلة لكل
         كثافة (ldpi حتى xxxhdpi + anydpi-v26)، وواجهة Compose تُبنى بالكامل
         بوحدات dp/sp المستقلة عن الكثافة، فهذا الوسم يوثّق ذلك رسمياً. -->
    <supports-screens
        android:anyDensity="true"
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:resizeable="true" />

    <application
        android:name=".HerbalApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HerbalEncyclopedia"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.HerbalEncyclopedia.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- يحمّل ملف التحديث (.apk) بالخلفية حتى لو أُغلقت شاشة التطبيق
             أو خرج المستخدم منه تماماً — راجع UpdateDownloadService. -->
        <service
            android:name=".data.update.UpdateDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- يبدأ تحميل التحديث مباشرة من زر "تحميل" داخل إشعار "تحديث
             متوفر" نفسه (لوحة الإشعارات)، بلا فتح أي واجهة — راجع
             UpdateNotifier وUpdateDownloadActionReceiver. غير مُصدَّر
             (exported=false): يُستقبل فقط من نيّة صريحة (PendingIntent)
             ينشئها التطبيق نفسه، لا من أي تطبيق آخر على الجهاز. -->
        <receiver
            android:name=".data.update.UpdateDownloadActionReceiver"
            android:exported="false" />

        <!-- Exposes the .apk file we download in-app (in the private cache dir) to the
             system package installer via a content:// Uri, as required from API 24+
             (installers can no longer be given a plain file:// Uri to a private path). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>

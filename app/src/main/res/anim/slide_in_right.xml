<?xml version="1.0" encoding="utf-8"?>
<!--
  Smooth "enter" transition: a short fade-in combined with a subtle slide
  from the right — matches the RTL layout direction forced app-wide (see
  ShopManagerTheme in Theme.kt), so this reads as "sliding in from where
  content naturally starts" instead of the LTR default. Distance is kept
  small (12% of width) and the curve is claude_ease (see
  res/interpolator/) — the same quick-start/no-overshoot ease-out as
  every Compose transition in the app (MotionSpecs.claudeEasing) — instead
  of the platform's own decelerate_cubic, so it eases to a stop instead of
  arriving abruptly without looking like a different app's motion. Used
  for window/activity-level transitions (see themes.xml); the in-app
  screen/tab transitions themselves are handled in Compose (MainActivity's
  NavHost enter/exitTransition, HorizontalPager) since this is a
  Compose-first app.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate
        android:fromXDelta="12%"
        android:toXDelta="0%"
        android:duration="260"
        android:interpolator="@interpolator/claude_ease" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="220"
        android:interpolator="@interpolator/claude_ease" />
</set>

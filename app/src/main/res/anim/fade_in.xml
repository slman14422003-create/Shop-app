<?xml version="1.0" encoding="utf-8"?>
<!-- Plain, cheap fade-in — used where a slide would be too busy (e.g. the
     task-switcher thumbnail returning to the app). Kept separate from
     slide_in_right.xml so call sites can pick "flexible" (slide+fade) or
     "minimal" (fade only) per situation instead of one fixed motion
     everywhere. Uses claude_ease (see res/interpolator/) — the same curve
     as every Compose transition in the app (MotionSpecs.claudeEasing) —
     instead of the platform's own decelerate_quad, so this one window-level
     animation doesn't read as off-brand next to the rest of the app. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0.0"
    android:toAlpha="1.0"
    android:duration="200"
    android:interpolator="@interpolator/claude_ease" />

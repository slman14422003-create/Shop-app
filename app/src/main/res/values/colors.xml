<resources>
    <!-- Brand — kept here too because the splash screen / window
         background below are drawn before any Compose/Kotlin code runs and
         can't reference a Compose Color directly.
         REDESIGN ("صمم الالوان بتصميم ChatGPT"): unified with
         ui/theme/Color.kt's ClaudeOrangeLight — ChatGPT's own link/highlight
         blue, replacing the old terracotta #C96442, so pre-Compose chrome
         (splash, window background, ripple) matches Compose's actual accent. -->
    <color name="brand_claude_primary">#2F80ED</color>
    <color name="brand_claude_secondary">#6E6E80</color>

    <!-- Semantic — mirrors Color.kt's ClaudeAccentGreenLight/GoldLight/
         RedLight/SecondaryLight so anything drawn outside Compose
         (notification tint, adaptive icon, future widgets) stays visually
         consistent with the in-app palette instead of picking its own
         colors. -->
    <color name="success_green">#10A37F</color>
    <color name="warning_amber">#B5811B</color>
    <color name="danger_red">#D93025</color>
    <color name="info_blue">#6E6E80</color>

    <!-- Light-mode surfaces — clean white/off-white ChatGPT ladder, used by
         the window background and any XML-drawn chrome before Compose takes
         over. -->
    <color name="surface_light">#FFFFFF</color>
    <color name="background_light">#FFFFFF</color>
    <color name="surface_variant_light">#ECECF1</color>

    <!-- Ripple / touch-feedback tint and scroll edge-glow color, tied to
         the same exact blue as ClaudeOrangeLight. -->
    <color name="ripple_brand">#1F2F80ED</color>
    <color name="edge_glow_brand">#2F80ED</color>

    <!-- Splash follows system light/dark theme (white here, pure black in
         values-night/colors.xml). -->
    <color name="splash_background">#FFFFFF</color>
</resources>

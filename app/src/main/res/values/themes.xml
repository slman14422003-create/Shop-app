<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      UI FIX (startup jitter/flash): before this, MainActivity used the
      bare `Theme.ShopManager` from the very first frame — meaning the
      OS's default starting window was blank/white, and only once Compose
      finished its first composition did SetSystemBarsColor (in
      MainActivity.kt) repaint the status/nav bars to the brand color.
      That white→indigo repaint, landing while Firebase/WorkManager/tier
      detection were still doing work on the main thread (see
      AndroidManifest.xml and MainActivity.kt), is what read as the app
      "shaking" for the first couple of seconds — content and system-bar
      colors were changing under the user's thumb while the phone was
      still catching up.

      Theme.ShopManager.Splash now shows a static app icon on a flat
      brand-color background immediately, with nothing to animate or
      recompose, and stays up (MainActivity controls exactly how long via
      setKeepOnScreenCondition) until the real first frame is fully ready
      to show — so the phone never shows a half-finished frame.
    -->
    <style name="Theme.ShopManager.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_indigo</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ShopManager</item>
    </style>

    <!--
      Window-level enter/exit transition (task switcher return, and any
      future second Activity): a soft fade+slide in, a quicker fade+slide
      out — see res/anim/. This is the one place a *window* transition can
      live in an app built almost entirely with Jetpack Compose; every
      in-app screen/tab transition itself is a Compose animation (see
      MainActivity's NavHost enter/exitTransition and MotionSpecs.kt), not
      an XML one — this style only covers the outer window edges.
    -->
    <style name="Theme.ShopManager.WindowAnimations" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
    </style>

    <!-- windowBackground now matches the brand color instead of the
         Material default white: if there's ever a one-frame gap between
         the splash screen handing off and Compose's first pixel, the
         background underneath is already the right color instead of a
         white flash. -->
    <style name="Theme.ShopManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/brand_indigo</item>
        <item name="android:windowAnimationStyle">@style/Theme.ShopManager.WindowAnimations</item>

        <!-- Ripple/touch-feedback tint on every tap, and the color of the
             glow shown at scroll edges/over-scroll — both previously the
             platform default grey, now tied to the brand palette (see
             colors.xml) so even the smallest, most frequent touch
             feedback in the app reads as part of one cohesive design. -->
        <item name="android:colorControlHighlight">@color/ripple_brand</item>
        <item name="android:colorEdgeEffect" tools:targetApi="s">@color/edge_glow_brand</item>
    </style>
</resources>

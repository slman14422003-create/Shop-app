<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HerbalEncyclopedia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.HerbalEncyclopedia.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- إصلاح: كانت هذه صورة PNG ثابتة (mipmap/ic_splash_logo) رغم أن
             الخاصية اسمها "AnimatedIcon" — أي لا حركة فعلية إطلاقاً هنا رغم
             ضبط مدة حركة (windowSplashScreenAnimationDuration) أدناه بلا أي
             أثر مرئي لها. الآن تشير لـ avd/animated-vector حقيقي (نفس ورقة
             الشعار، بحركة "تكبّر ناعمة" عند ظهورها) فتتحرك الأيقونة فعلياً
             في شاشة النظام قبل ظهور شاشة البداية الخاصة بالتطبيق (Compose). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_icon</item>
        <!-- دائرة بيضاء خلف الأيقونة، لتطابق دائرة الزجاج البيضاء التي
             تحيط بالأيقونة في شاشة البداية داخل التطبيق (Compose)، بدل
             ورقة عائمة مباشرة على الأخضر بلا تباين واضح. -->
        <item name="windowSplashScreenIconBackgroundColor">@android:color/white</item>
        <item name="postSplashScreenTheme">@style/Theme.HerbalEncyclopedia</item>
        <!-- تُطابق الآن فعلياً مدة حركة avd_splash_icon (420ms) بدل رقم
             عشوائي بلا علاقة بأي حركة حقيقية كما كان سابقاً. -->
        <item name="windowSplashScreenAnimationDuration">420</item>
    </style>
</resources>

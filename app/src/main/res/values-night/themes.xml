<?xml version="1.0" encoding="utf-8"?>
<!--
  Night-mode override: everything else (splash screen, ripple/edge colors,
  window animation style) stays identical to values/themes.xml — only
  windowBackground changes, from the fixed brand indigo to this app's
  actual dark-mode background (Color.kt's DarkBackground, #121218, via the
  night-qualified background_light in values-night/colors.xml). Brand
  indigo behind a *dark* first Compose frame was a mismatched flash for
  roughly one frame during the splash → content handoff; matching tones
  removes that regardless of which theme the person is using.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ShopManager" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background_light</item>
        <item name="android:windowAnimationStyle">@style/Theme.ShopManager.WindowAnimations</item>
        <item name="android:colorControlHighlight">@color/ripple_brand</item>
        <item name="android:colorEdgeEffect" tools:targetApi="s">@color/edge_glow_brand</item>
    </style>
</resources>

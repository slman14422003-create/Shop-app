<?xml version="1.0" encoding="utf-8"?>
<!--
  Night-mode overrides — picked up automatically whenever the device is in
  dark mode, no Kotlin code needed to select this file. Brand/semantic
  colors stay identical to values/colors.xml (a brand color shouldn't
  change with theme — see BrandGradientStart's own comment in Color.kt),
  only the *surface* tones below are swapped for the dark-mode equivalents
  from Color.kt's DarkBackground/DarkSurface/DarkSurfaceVariant. This is
  what lets the window background (see themes.xml) match Compose's actual
  dark surface instead of staying a fixed color regardless of theme — one
  less possible flash of the wrong tone during the splash → first-frame
  handoff when the app is opened in dark mode.

  FIXED (colors): brand_claude_*/ripple_brand/edge_glow_brand below are now
  unified 1:1 with the Phizyo reference app's values-night/colors.xml
  (claude_orange #D97757 in dark mode), replacing the old off-palette
  #CC7A52/lavender-blue values, so touch feedback matches the real
  Compose-rendered accent exactly in dark mode too.
-->
<resources>
    <color name="brand_claude_primary">#D97757</color>
    <color name="brand_claude_secondary">#B7B4AC</color>

    <color name="success_green">#8CB894</color>
    <color name="warning_amber">#D3A461</color>
    <color name="danger_red">#E0916D</color>
    <color name="info_blue">#B7B4AC</color>

    <!-- Unified with Phizyo's surface_dark/bg_deep_2/m3_surface_variant
         (dark mode) instead of the old cool-toned #1B1B24/#121218/#2A2A38. -->
    <color name="surface_light">#1F1F1F</color>
    <color name="background_light">#131313</color>
    <color name="surface_variant_light">#2B2B2B</color>

    <!-- POLISH: see values/colors.xml's note — same proportional alpha cut
         applied here (was #40 / 25%), keeping the original light/dark
         ripple-strength ratio intact. -->
    <color name="ripple_brand">#26D97757</color>
    <color name="edge_glow_brand">#D97757</color>

    <!-- Unified with Phizyo's bg_deep_1 (dark mode) — the splash follows
         system theme like the reference app now; see values/colors.xml's
         note for the light-mode counterpart. -->
    <color name="splash_background">#131313</color>
</resources>

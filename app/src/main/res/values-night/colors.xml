<?xml version="1.0" encoding="utf-8"?>
<!--
  Night-mode overrides — picked up automatically whenever the device is in
  dark mode, no Kotlin code needed to select this file. Only the *surface*
  tones below are swapped for the dark-mode equivalents from Color.kt's
  ClaudeBgDark1/ClaudeCardDark/ClaudeM3SurfaceVariantDark. This is what lets
  the window background (see themes.xml) match Compose's actual dark surface
  instead of staying a fixed color regardless of theme.

  REDESIGN ("صمم الالوان بتصميم ChatGPT"): brand_claude_*/ripple_brand/
  edge_glow_brand below are now ChatGPT's dark-mode link-blue (#5B9DF9,
  matching ClaudeOrangeDark), replacing the old dark-mode coral #D97757.
-->
<resources>
    <color name="brand_claude_primary">#5B9DF9</color>
    <color name="brand_claude_secondary">#A6A6B2</color>

    <color name="success_green">#19C37D</color>
    <color name="warning_amber">#E0AC4F</color>
    <color name="danger_red">#F2685C</color>
    <color name="info_blue">#A6A6B2</color>

    <!-- ChatGPT's true near-black dark-mode ladder (pure black base). -->
    <color name="surface_light">#171717</color>
    <color name="background_light">#000000</color>
    <color name="surface_variant_light">#2B2B2B</color>

    <color name="ripple_brand">#265B9DF9</color>
    <color name="edge_glow_brand">#5B9DF9</color>

    <!-- Splash follows system theme — pure black in dark mode, matching
         ClaudeBgDark1. -->
    <color name="splash_background">#000000</color>
</resources>

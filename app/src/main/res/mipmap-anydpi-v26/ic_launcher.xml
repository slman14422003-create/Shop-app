<?xml version="1.0" encoding="utf-8"?>
<!--
    "زجاج سائل" launcher icon (API 26+ adaptive icon).

    background = the brand diagonal gradient (same colors as BrandGradient
    in Kotlin, see colors.xml's brand_indigo/brand_violet).
    foreground = the glass orb + storefront glyph, generated with a soft
    drop shadow, a translucent gradient fill, a rim shadow, and a bright
    specular highlight to read as glass rather than a flat circle — see
    the design note in ic_launcher_foreground's source generation.

    Pre-API26 launchers ignore this file entirely and use the flat PNGs in
    mipmap-<density>/ic_launcher.png instead (regenerated to match this
    same design, flattened to one layer, so both versions look identical).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

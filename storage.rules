rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // The Android app stores herb images in Firestore as data URIs and does not
    // need Firebase Storage. Keep the bucket closed unless a future feature
    // adds an explicit, reviewed storage rule.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

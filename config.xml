<?xml version='1.0' encoding='utf-8'?>
<widget id="com.shopmanager.app" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>إدارة المحل</name>
    <description>
        تطبيق موحّد لإدارة ديون الزبائن والمواد والأسعار في المحل، مبني على Apache Cordova (Android/Java).
    </description>
    <author email="owner@example.com" href="https://github.com/">فريق إدارة المحل</author>

    <content src="index.html" />

    <access origin="*" />
    <allow-navigation href="*" />
    <allow-intent href="*" />

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="BackgroundColor" value="0xff0f0f1a" />
    <preference name="AndroidWindowSplashScreenBackground" value="#0f0f1a" />
    <preference name="AndroidXEnabled" value="true" />
    <preference name="SplashMaintainAspectRatio" value="true" />
    <preference name="loadUrlTimeoutValue" value="60000" />
    <preference name="AndroidPersistentFileLocation" value="Internal" />

    <platform name="android">
        <preference name="AndroidLaunchMode" value="singleTask" />
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application" xmlns:android="http://schemas.android.com/apk/res/android">
            <application android:usesCleartextTraffic="true" />
        </edit-config>

        <icon density="ldpi" src="www/icons/icon-72x72.png" />
        <icon density="mdpi" src="www/icons/icon-72x72.png" />
        <icon density="hdpi" src="www/icons/icon-72x72.png" />
        <icon density="xhdpi" src="www/icons/icon-96x96.png" />
        <icon density="xxhdpi" src="www/icons/icon-144x144.png" />
        <icon density="xxxhdpi" src="www/icons/icon-192x192.png" />
    </platform>

    <plugin name="cordova-plugin-whitelist" spec="^1.3.5" />
    <plugin name="cordova-plugin-splashscreen" spec="^6.0.2" />
</widget>

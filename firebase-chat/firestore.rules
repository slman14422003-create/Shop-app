rules_version = '2';

// قواعد Firestore الخاصة بمشروع الدردشة المحلية فقط (shop-app-1670f).
// ⚠ لا علاقة لها بقواعد مشروع الديون والمواد (../firestore.rules، مشروع shop-app-6d35e).
//
// المبدأ: لا قراءة ولا كتابة إلا لمستخدم مسجّل، ولا يدخل أحد محادثة ليس طرفاً فيها.
// معرّف المحادثة = uidA_uidB (مرتّبان)، وUID في Firebase Auth لا يحتوي "_" فيُستخدم المعرّف
// نفسه للتحقق من العضوية بدون قراءات إضافية.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function inChatId(chatId) {
      return signedIn() && me() in chatId.split('_');
    }
    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // ───────────── المستخدمون ─────────────
    match /users/{uid} {
      // كل مستخدم مسجّل يرى الأسماء وآخر ظهور (لقائمة "محادثة جديدة" وحالة متصل).
      allow read: if signedIn();

      // إنشاء الملف مرة واحدة عند التسجيل، بالتزامن مع حجز الاسم (نفس العملية الذرّية في التطبيق).
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'deviceId', 'createdAt', 'lastSeen'])
        && request.resource.data.keys().hasAll(['name', 'nameLower', 'deviceId', 'createdAt', 'lastSeen'])
        && request.resource.data.deviceId is string
        && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.uid == uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 20
        && request.resource.data.nameLower is string
        && request.resource.data.nameLower.size() >= 2 && request.resource.data.nameLower.size() <= 20
        && request.resource.data.createdAt == request.time
        && request.resource.data.lastSeen == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.nameLower)).data.uid == uid;

      // الوحيد المسموح تعديله: آخر ظهور (النبضة)، وبقيمة وقت الخادم.
      allow update: if signedIn() && uid == me()
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen'])
            && request.resource.data.lastSeen == request.time)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceId'])
            && !('deviceId' in resource.data)
            && getAfter(/databases/$(database)/documents/devices/$(request.resource.data.deviceId)).data.uid == uid)
        );

      allow delete: if false;
    }

    // ───────────── ربط الجهاز بحساب واحد ─────────────
    match /devices/{deviceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == me()
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ───────────── حجز اسم المستخدم (فريد) ─────────────
    match /usernames/{name} {
      allow read: if signedIn();
      // الإنشاء فقط (لا تعديل ولا حذف): من حجز اسماً يبقى له.
      allow create: if signedIn()
        && name.size() >= 2 && name.size() <= 20
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ───────────── المحادثات ─────────────
    match /chats/{chatId} {

      // مستند واحد (يشمل محادثة لم تُنشأ بعد): يكفي أن يكون معرّفك ضمن معرّف المحادثة.
      allow get: if inChatId(chatId);

      // قائمة المحادثات (الاستعلام array-contains على members): محادثاتك فقط.
      allow list: if signedIn() && me() in resource.data.members;

      allow create: if inChatId(chatId)
        && request.resource.data.keys().hasOnly(
             ['members', 'names', 'lastText', 'lastType', 'lastFrom', 'lastTime', 'unread', 'reads', 'typing', 'clears'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members.hasAll(chatId.split('_'))
        && userExists(request.resource.data.members[0])
        && userExists(request.resource.data.members[1])
        && request.resource.data.lastFrom == me()
        && request.resource.data.lastTime == request.time
        && request.resource.data.lastType in ['text', 'voice']
        && request.resource.data.lastText is string && request.resource.data.lastText.size() <= 120;

      allow update: if signedIn() && me() in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['names', 'lastText', 'lastType', 'lastFrom', 'lastTime', 'unread', 'reads', 'typing', 'clears'])
        // تغيير آخر رسالة = إرسال رسالة: يجب أن أكون المرسل وبوقت الخادم.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastTime'])
            || (request.resource.data.lastFrom == me()
                && request.resource.data.lastTime == request.time
                && request.resource.data.lastType in ['text', 'voice']
                && request.resource.data.lastText is string
                && request.resource.data.lastText.size() <= 120))
        // "قرأت" و"أكتب" خاصّان بي أنا فقط (لا أعدّل حالة الطرف الآخر).
        && request.resource.data.get('reads', {}).diff(resource.data.get('reads', {})).affectedKeys().hasOnly([me()])
        && request.resource.data.get('typing', {}).diff(resource.data.get('typing', {})).affectedKeys().hasOnly([me()])
        && request.resource.data.get('clears', {}).diff(resource.data.get('clears', {})).affectedKeys().hasOnly([me()]);

      allow delete: if false;

      // ───────────── الرسائل (نص أو صوت) ─────────────
      match /messages/{msgId} {
        allow read: if inChatId(chatId);

        allow create: if inChatId(chatId)
          && request.resource.data.keys().hasOnly(
               ['from', 'type', 'text', 'createdAt', 'audio', 'durationMs', 'wave', 'expireAt', 'reply'])
          && request.resource.data.keys().hasAll(['from', 'type', 'text', 'createdAt'])
          && request.resource.data.from == me()
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text', 'voice']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (
            request.resource.data.type == 'text'
              ? (request.resource.data.text.size() >= 1 && !('audio' in request.resource.data))
              : (request.resource.data.audio is string
                 && request.resource.data.audio.size() > 0
                 && request.resource.data.audio.size() <= 900000
                 && request.resource.data.durationMs is number
                 && request.resource.data.durationMs <= 125000
                 && request.resource.data.wave is list
                 && request.resource.data.wave.size() <= 64
                 && request.resource.data.expireAt is timestamp
                 && request.resource.data.expireAt > request.time)
          );

        // تعديل: صاحب الرسالة النصية يعدّل النص فقط (وعلامة edited). التفاعل: كل عضو يغيّر تفاعله هو فقط.
        allow update: if inChatId(chatId)
          && (
            (resource.data.from == me()
              && resource.data.type == 'text'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited'])
              && request.resource.data.text is string
              && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
              && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {})).affectedKeys().hasOnly([me()]))
          );

        // الحذف: صاحب الرسالة يحذفها للجميع، ولأي طرف حذف الرسالة الصوتية التي انتهت مدتها (تنظيف تلقائي).
        allow delete: if inChatId(chatId)
          && (
            resource.data.from == me()
            || (resource.data.type == 'voice'
                && resource.data.expireAt is timestamp
                && resource.data.expireAt < request.time)
          );
      }
    }

    // أي مسار آخر: مرفوض.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

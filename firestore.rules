rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'OWssFNrZDaZfeSlrLF8ReS8O6LM2';
    }

    function isString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validCategory(data) {
      return data.keys().hasOnly(['name', 'icon', 'created_at', 'updated_at'])
        && isString(data.name, 200)
        && (!('icon' in data) || data.icon == null || isString(data.icon, 100));
    }

    function validUpdateConfig(data) {
      return data.keys().hasOnly([
          'enabled', 'github_repo', 'override_version_name',
          'release_notes_override', 'min_version_code', 'updated_at'
        ])
        && data.enabled is bool
        && isString(data.github_repo, 200)
        && (!('override_version_name' in data) || data.override_version_name == null || isString(data.override_version_name, 50))
        && (!('release_notes_override' in data) || data.release_notes_override == null || isString(data.release_notes_override, 2000))
        && data.min_version_code is int;
    }

    function validHerb(data) {
      return data.keys().hasOnly([
          'name', 'category_id', 'benefits', 'warnings', 'harms', 'usage',
          'notes', 'image_url', 'created_at', 'updated_at'
        ])
        && isString(data.name, 200)
        && (!('category_id' in data) || data.category_id == null || isString(data.category_id, 150))
        && isString(data.benefits, 10000)
        && isString(data.warnings, 10000)
        && isString(data.harms, 10000)
        && isString(data.usage, 10000)
        && isString(data.notes, 10000)
        && (!('image_url' in data) || data.image_url == null || isString(data.image_url, 700000));
    }

    match /herbs/{herbId} {
      allow get, list: if true;
      allow create: if isAdmin() && validHerb(request.resource.data);
      allow update: if isAdmin() && validHerb(request.resource.data);
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create: if isAdmin() && validCategory(request.resource.data);
      allow update: if isAdmin() && validCategory(request.resource.data);
      allow delete: if isAdmin();
    }

    // Update metadata is readable by everyone so the app can check for releases
    // without exposing any write capability. Only the fixed admin UID may change it.
    match /app_config/update {
      allow get: if true;
      allow list: if false;
      allow create, update: if isAdmin() && validUpdateConfig(request.resource.data);
      allow delete: if isAdmin();
    }

    // الخلطات: كانت بلا قاعدة فتُرفض القراءة دائماً (PERMISSION_DENIED) وتفشل المزامنة.
    match /blends/{blendId} {
      allow get, list: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // وضع الصيانة: قراءة للجميع، كتابة للأدمن.
    match /app_config/maintenance {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // محتوى "سيمو" المدرَّب يدوياً: قراءة للجميع، نشر للأدمن.
    match /semo_trained/{docId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // تعلّم سيمو الذاتي: قراءة للجميع. إنشاء/تعديل من أي جهاز مسجّل (مجهول مقبول)،
    // والتعديل مقصور على عدّادات التصويت وupdated_at فقط.
    match /semo_learned/{docId} {
      allow get, list: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pattern', 'response', 'upvotes', 'downvotes', 'voters', 'created_at', 'updated_at'])
        && isString(request.resource.data.pattern, 500)
        && isString(request.resource.data.response, 5000)
        && request.resource.data.upvotes == 1
        && request.resource.data.downvotes == 0
        && request.resource.data.voters == [request.auth.uid];
      allow update: if request.auth != null && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upvotes', 'voters', 'updated_at'])
          && request.auth.uid in request.resource.data.voters
          && !(request.auth.uid in resource.data.get('voters', []))
          && request.resource.data.voters.size() == resource.data.get('voters', []).size() + 1
          && request.resource.data.upvotes == resource.data.upvotes + 1
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downvotes', 'updated_at'])
          && request.resource.data.downvotes == resource.data.downvotes + 1
        )
      );
      allow delete: if isAdmin();
    }

    // أعشاب تعلّمها سيمو من الإنترنت: قراءة للجميع، إنشاء من أي جهاز مسجّل بحالة
    // "غير معتمد" فقط، والاعتماد/التعديل/الحذف للأدمن حصراً.
    match /semo_web_herbs/{docId} {
      allow get, list: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'name', 'aliases', 'latin_name', 'benefits', 'usage', 'warnings',
          'harms', 'notes', 'alias_of', 'approved', 'grounded', 'created_at'
        ])
        && isString(request.resource.data.name, 200)
        && request.resource.data.approved == false
        && request.resource.data.aliases is list
        && request.resource.data.aliases.size() <= 10
        && isString(request.resource.data.latin_name, 200)
        && isString(request.resource.data.benefits, 5000)
        && isString(request.resource.data.usage, 5000)
        && isString(request.resource.data.warnings, 5000)
        && isString(request.resource.data.harms, 5000)
        && isString(request.resource.data.notes, 3000)
        && isString(request.resource.data.alias_of, 200);
      allow update, delete: if isAdmin();
    }

    // أسئلة لم يجد لها سيمو جواباً: أي جهاز يضيف/يزيد العدّاد، والأدمن وحده يقرأ ويحذف.
    match /semo_unanswered/{docId} {
      allow get, list, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['question', 'count', 'updated_at'])
        && isString(request.resource.data.question, 500)
        && request.resource.data.count == 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updated_at'])
        && request.resource.data.count == resource.data.count + 1;
    }

    // معرّفات الحظر: الأدمن يديرها، والجهاز يقرأ مستنده الخاص فقط.
    match /blocked_users/{uid} {
      allow get: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ملاحظات المستخدمين: إرسال من جهاز مسجّل غير محظور، قراءة/حذف للأدمن.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.sender_uid == request.auth.uid
        && !exists(/databases/$(database)/documents/blocked_users/$(request.auth.uid))
        && isString(request.resource.data.message, 5000);
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // إحصائية الأجهزة: كل جهاز يكتب/يقرأ مستنده فقط، والأدمن يقرأ الكل (العدّ).
    match /devices/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow list: if isAdmin();
      allow delete: if false;
    }

    // سجل الأعطال: الإرسال مسموح (قد يحدث قبل أي تسجيل)، القراءة/الحذف للأدمن.
    match /crash_logs/{logId} {
      allow create: if isString(request.resource.data.message, 600);
      allow get, list, delete: if isAdmin();
      allow update: if false;
    }

    // All other collections/documents are denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
